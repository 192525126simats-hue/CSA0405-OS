1)BEGIN
SET limit = 80%
CHECK disk usage
IF usage > limit THEN
FIND log files
FOR each log file DO
DELETE or COMPRESS file
CHECK disc usage
IF usage <= 80% THEN
BREAK
ENDIF
ENDFOR
ENDIF
END

2)BEGIN
INPUT process_list
WHILE process_list is not empty DO
SELECT process with highest priority
EXECUTE process
IF process is not completed THEN
ADD process back to list
ENDIF
ENDWHILE
END

3)BEGIN
SET total_RAM = 16GB
SET host_RAM = 4GB
SET VM_RAM = 2GB
available_RAM = total_RAM - host_RAM
FOR each VM DO
IF available_RAM >= VM_RAM THEN
ALLOCATE 2GB to VM
available_RAM = available_RAM - 2GB
ELSE
PRINT "Insufficient RAM"
ENDIF
ENDFOR
END

