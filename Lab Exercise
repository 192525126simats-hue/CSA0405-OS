#include <stdio.h>
int main()
{
int b[5] = {100, 500, 200, 300, 600};
int p[4] = {212, 417, 112, 426};
int i, j, k;
printf("First Fit:\n");
for(i = 0; i < 4; i++)
{
for(j = 0; j < 5; j++)
{
if(b[j] >= p[i])
{
printf("P%d -> B%d\n", i+1, j+1);
b[j] -= p[i];
break;
}
}
}
printf("\nBest Fit:\n");
for(i = 0; i < 4; i++)
{
k = -1;
for(j = 0; j < 5; j++)
if(b[j] >= p[i] && (k == -1 || b[j] < b[k]))
k = j;
if(k != -1)
{
printf("P%d -> B%d\n", i+1, k+1);
b[k] -= p[i];
}
}
printf("\nWorst Fit:\n");
for(i = 0; i < 4; i++)
{
k = -1;
for(j = 0; j < 5; j++)
if(b[j] >= p[i] && (k == -1 || b[j] > b[k]))
k = j;
if(k != -1)
{
printf("P%d -> B%d\n", i+1, k+1);
b[k] -= p[i];
}
}
return 0;
}
OUTPUT:
First Fit:
P1 -> B2
P2 -> B5
P3 -> B2
Best Fit:
P1 -> B4
P3 -> B5
Worst Fit:
P3 -> B3


