#include <stdio.h>
int main() {
int bt[10], rt[10], n, tq, i, time = 0;
printf("Enter number of processes: ");
scanf("%d", &n);
for(i = 0; i < n; i++) {
scanf("%d", &bt[i]);
rt[i] = bt[i];
}
printf("Enter Time Quantum: ");
scanf("%d", &tq);
while(1) {
int done = 1;
for(i = 0; i < n; i++) {
if(rt[i] > 0) {
done = 0;
if(rt[i] > tq) {
time += tq;
rt[i] -= tq;
} else {
time += rt[i];
printf("P%d completed at %d\n", i + 1, time);
rt[i] = 0;
}
}
}
if(done)
break;
}
return 0;
}
SAMPLE INPUT:
Enter number of processes: 3
5
4
2
Enter Time Quantum: 2
OUTPUT:
P3 completed at 6
P2 completed at 10
P1 completed at 11


