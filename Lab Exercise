#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <string.h>
struct msg {
long type;
char text[50];
};
int main() {
struct msg m;
int msgid;
// Create message queue
msgid = msgget(1234, 0666 | IPC_CREAT);
// Send message
m.type = 1;
strcpy(m.text, "Hello");
msgsnd(msgid, &m, sizeof(m.text), 0);
// Receive message
msgrcv(msgid, &m, sizeof(m.text), 1, 0);
printf("Message: %s\n", m.text);
return 0;
}
OUTPUT:
Message: Hello


