#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main() {
int fd;
struct stat st;
DIR *dir;
struct dirent *entry;
fd = open("test.txt", O_RDONLY);
// fcntl()
printf("File descriptor flags: %d\n", fcntl(fd, F_GETFL));
// lseek()
printf("File size using lseek: %ld bytes\n",
lseek(fd, 0, SEEK_END));
// stat()
stat("test.txt", &st);
printf("File size using stat: %ld bytes\n", st.st_size);
close(fd);
// opendir() and readdir()
dir = opendir(".");
printf("\nFiles in current directory:\n"
while ((entry = readdir(dir)) != NULL) {
printf("%s\n", entry->d_name);
}
closedir(dir);
return 0;
}
