for (j = 0; j < f; j++) {
if (frame[j] == pages[i])
found = 1;
}
if (!found) {
frame[k] = pages[i];
k = (k + 1) % f;
fault++;
}
for (j = 0; j < f; j++)
printf("%d ", frame[j]);
printf("\n");
}
printf("Total Page Faults = %d\n", fault);
return 0;
}
