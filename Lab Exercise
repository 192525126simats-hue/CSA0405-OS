#include <stdio.h>
int main() {
int n, i, j;
int p[10], pr[10], temp;
printf("Enter number of processes: ");
scanf("%d", &n);
printf("Enter process numbers and priorities:\n");
for(i = 0; i < n; i++) {
scanf("%d %d", &p[i], &pr[i]);
}
// Sort based on highest priority (larger number = higher priority)
for(i = 0; i < n - 1; i++) {
for(j = i + 1; j < n; j++) {
if(pr[i] < pr[j]) {
temp = pr[i];
pr[i] = pr[j];
pr[j] = temp;
temp = p[i];
p[i] = p[j];
p[j] = temp;
}
}
}
printf("\nExecution Order:\n");
for(i = 0; i < n; i++) {
printf("P%d ", p[i]);
}
return 0;
}
OUTPUT:
Execution Order:
P2 P4 P1 P3


                                     Exercise-6
#include <stdio.h>
int main() {
int n, bt[10], pr[10], rt[10];
int i, time = 0, complete = 0, high;
printf("Enter number of processes: ");
scanf("%d", &n);
printf("Enter Burst Time and Priority:\n");
for(i = 0; i < n; i++) {
scanf("%d%d", &bt[i], &pr[i]);
rt[i] = bt[i];
}
while(complete < n) {
high = -1;
for(i = 0; i < n; i++) {
if(rt[i] > 0) {
if(high == -1 || pr[i] < pr[high])
high = i;
}
}
rt[high]--;
time++;
if(rt[high] == 0) {
complete++;
printf("P%d completed at time %d\n", high + 1, time);
}
}
return 0;
}
OUTPUT:
P2 completed at time 3
P1 completed at time 8
P3 completed at time 12


