3)#include <stdio.h>
#include <stdlib.h>
int main() {
int a[10], n, h, i, j, t, seek = 0, cur;
int used[10] = {0};
printf("Enter n, head: ");
scanf("%d%d", &n, &h);
printf("Requests: ");
for(i=0;i<n;i++) scanf("%d",&a[i]);
/* FCFS */
cur=h;
printf("\nFCFS: ");
for(i=0;i<n;i++) {
seek += abs(cur-a[i]);
cur=a[i];
printf("%d ",cur);
}
printf("\nSeek=%d",seek);
/* SSTF */
seek=0; cur=h;
printf("\nSSTF: ");
for(i=0;i<n;i++) {
int min=9999,k=0;
for(j=0;j<n;j++)
if(!used[j] && abs(cur-a[j])<min)
min=abs(cur-a[j]),k=j;
used[k]=1;
seek+=min; cur=a[k];
printf("%d ",cur);
}
printf("\nSeek=%d",seek);
return 0;
}
INPUT:
Enter n, head: 8 53
Requests: 98 183 37 122 14 124 65 67
OUTPUT:
FCFS: 98 183 37 122 14 124 65 67
Seek=640
SSTF: 65 67 37 14 98 122 124 183
Seek=236


4)#include <stdio.h>
#include <stdlib.h>
int main() {
int a[10], n, h, s, i, j, t, c=0, l=0, x;
scanf("%d%d%d",&n,&h,&s);
for(i=0;i<n;i++) scanf("%d",&a[i]);
for(i=0;i<n-1;i++)
for(j=i+1;j<n;j++)
if(a[i]>a[j])
t=a[i],a[i]=a[j],a[j]=t;
x=h;
printf("C-SCAN: ");
for(i=0;i<n;i++)
if(a[i]>=h) c+=abs(x-a[i]),x=a[i],printf("%d ",x);
c+=s-1-x+s-1;
x=0;
for(i=0;i<n;i++)
if(a[i]<h) c+=abs(x-a[i]),x=a[i],printf("%d ",x);
x=h;
printf("\nLOOK: ");
for(i=0;i<n;i++)
if(a[i]>=h) l+=abs(x-a[i]),x=a[i],printf("%d ",x);
for(i=n-1;i>=0;i--)
if(a[i]<h) l+=abs(x-a[i]),x=a[i],printf("%d ",x);
printf("\nC-SCAN=%d\nLOOK=%d",c,l);
printf("\nBest: %s",l<c?"LOOK":"C-SCAN");
return 0;
}
INPUT:
8 53 200
98 183 37 122 14 124 65 67
OUTPUT:
C-SCAN: 65 67 98 122 124 183 14 37
LOOK: 65 67 98 122 124 183 37 14
C-SCAN=329
LOOK=299
Best: LOOK

