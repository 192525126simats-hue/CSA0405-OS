2)#include <stdio.h>
int main() {
int n, b[50], req, i, count = 0, x;
printf("Enter number of blocks: ");
scanf("%d", &n);
printf("Enter bitmap: ");
for (i = 0; i < n; i++)
scanf("%d", &b[i]);
printf("Enter blocks required: ");
scanf("%d", &req);
/* Allocation */
for (i = 0; i < n && count < req; i++) {
if (b[i] == 0) {
b[i] = 1;
count++;
}
}
if (count < req)
printf("Not enough space\n");
else {
printf("After allocation: ");
for (i = 0; i < n; i++)
printf("%d ", b[i]);
}
/* Deallocation */
printf("\nEnter block to deallocate: ");
scanf("%d", &x);
if (x >= 0 && x < n)
b[x] = 0;
printf("After deallocation: ");
for (i = 0; i < n; i++)
printf("%d ", b[i]);
return 0;
}
